# Site Configuration
# This is used for SEO (robots.txt, sitemap.xml)
PUBLIC_SITE_URL=https://example.com

# Cloudflare Image Optimization
# Set to 'false' to disable Cloudflare Image Resizing (use original images)
# Requires Cloudflare DNS proxy enabled (orange cloud) and Image Resizing active
# Default: true (enabled)
PUBLIC_USE_CLOUDFLARE_IMAGES=false
